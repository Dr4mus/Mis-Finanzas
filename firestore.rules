rules_version = '2';
// Reglas de seguridad de Mis finanzas. Pégalas en Firebase > Firestore Database > Reglas.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Cada usuario solo ve su propio perfil (guarda a qué hogar pertenece).
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /hogares/{hid} {
      function isMember() { return signedIn() && request.auth.uid in resource.data.members; }
      // Crear un hogar: solo tú como miembro.
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      allow read: if isMember();
      // Los miembros pueden actualizarlo; alguien que tiene el código puede agregarse a sí mismo (máximo 6 personas).
      allow update: if isMember() || (
        signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() <= 6
      );
      allow delete: if false;

      // Datos del hogar: solo los miembros.
      match /items/{id} {
        allow read, write: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/hogares/$(hid)).data.members;
      }
    }
  }
}
